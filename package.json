  },
  "bugs": {
    "url": "https://github.com/LIN4CRE/SpeedRead/issues"
  },
  "keywords": [
    "speed-reading",
    "rsvp",
    "optimal-recognition-point",
    "orp",
    "epub-reader",
    "pdf-reader",
    "react",
    "vite",
    "typescript"
  ],
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
