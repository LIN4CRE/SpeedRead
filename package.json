  "version": "1.0.0",
  "description": "High-performance RSVP speed reader supporting PDF, ePub, TXT, and custom books with Optimal Recognition Point (ORP) focal tracking.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/LIN4CRE/SpeedRead#readme",
  "repository": {
    "type": "git",
